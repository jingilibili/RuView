  "live_path_session_2026_09_12": {
    "summary": "The pose-fusion UI served by the bundled sensing server stayed on watermarked SYNTHETIC data while three ESP32-S3 nodes were streaming CSI at ~30 fps each. Three independent defects were found; the governed trust path was stripping the per-node raw amplitude vectors on 45.9% of live cycles (privacy demotion), the UI treated such a stripped cycle as a verified live frame, and the page's WebSocket port guess (httpPort+1) never matched the bundled server (HTTP 8080 / WS 8765).",
    "evidence_class": "MEASURED",
    "root_causes": [
      {
        "id": "restricted_demotion_strips_amplitude",
        "where": "wifi-densepose-signal::ruvsense::multistatic::fuse_scored_calibrated -> wifi-densepose-engine::process_cycle -> sensing-server main.rs (ADR-141 output mapping)",
        "chain": [
          "ContradictionFlag::TimestampMismatch fires when the spread of the newest per-node frame timestamps exceeds config.soft_guard_us (default 20000 us)",
          "node_frames_from_states_with_guard falls back to host-arrival time when mesh time is unavailable, which is the case for plain CSI-over-UDP nodes",
          "3 nodes each emitting one frame per ~30 ms give a newest-arrival spread that is roughly uniform over one frame interval, so a 20 ms soft guard sits at the median",
          "demoted=true -> effective_class Restricted -> EngineBridge::suppress_raw_outputs() true -> main.rs publishes amplitude: [] and subcarrier_count: 0"
        ],
        "measured": {
          "soft_guard_us_20000": {
            "window_s": 14,
            "messages": 689,
            "full_amplitude": 373,
            "suppressed": 316,
            "suppression_rate": 0.459
          },
          "soft_guard_us_55000": {
            "window_s": 14,
            "messages": 882,
            "full_amplitude": 860,
            "suppressed": 22,
            "suppression_rate": 0.025
          },
          "engine_error_count": 0,
          "status_endpoint_alternation": "effective_class flipped Anonymous <-> Restricted about once per second with demoted true/false in step"
        },
        "fix_kind": "operator configuration, no code change",
        "fix": "start the sensing server with WDP_SOFT_GUARD_US=55000 (existing override; hard guard stays at 60 ms and the upstream invariant stagger < soft_guard_us < guard_interval_us still holds)",
        "upstream_follow_up": "a rate-limited warning or a demotion_reason field on /api/v1/status naming TimestampMismatch, so a silently stripped cycle is visible"
      },
      {
        "id": "ui_verified_an_amplitude_stripped_frame",
        "where": "ui/pose-fusion/js/csi-simulator.js::_handleJsonFrame",
        "detail": "Array.isArray([]) is true, so an amplitude-stripped cycle still called _markVerifiedFrame() and the buffers were blanked to zeros, showing 0.00 while isLive was already true",
        "fix": "require ampArr.length > 0 before decoding, keep the last verified frame when a cycle carries no decodable CSI, move the RSSI/presence refresh into _updateSensingMetadata",
        "pr": "https://github.com/ruvnet/RuView/pull/1911"
      },
      {
        "id": "ui_ws_port_guess",
        "where": "ui/pose-fusion/js/main.js",
        "detail": "the page guessed ws://<host>:<httpPort+1>/ws/sensing (Docker 3000->3001); the bundled server serves HTTP+UI on 8080 and the sensing WebSocket on 8765, so the guess resolved to 8081 and connectLive() failed silently",
        "fix": "reuse the SENSING_WS_PORT_BY_HTTP_PORT table from ui/services/sensing.service.js ({'3000':'3001','8080':'8765'}), keeping httpPort+1 only as the fallback",
        "pr": "https://github.com/ruvnet/RuView/pull/1911"
      }
    ],
    "wire_verification": {
      "method": "raw UDP datagrams decoded on port 5005 with a stdlib-only Python listener while the server was stopped",
      "result": "magic 0xC5110001, n_antennas 1, n_subcarriers 192/306/128/64, datagram length exactly 20 + n_ant * n_sub * 2 (e.g. n_sub=192 -> len=404 expected=404 FULL), freq 2462 MHz",
      "conclusion": "the IQ payload reaches the server complete and untruncated; the later empty amplitude is a publish-time privacy mapping, not a parse or wire problem"
    },
    "server_side_diagnostics": {
      "change": "handle_ws_client now logs the concrete break reason (send failed / broadcast channel closed / ping failed / client sent close / client stream ended / client error) and answers a client Ping with a Pong",
      "detail": "the break reason was previously discarded, so a dropped /ws/sensing stream was indistinguishable from one that never opened",
      "pr": "https://github.com/ruvnet/RuView/pull/1911"
    },
    "ui_verification": {
      "method": "headless Chrome (--headless=new --dump-dom --virtual-time-budget), fresh profile, no manual WebSocket URL, against the bundled server",
      "observed": {
        "status_label": "LIVE CSI",
        "connect_button": "Live ESP32 (class active)",
        "rssi_value": "-54 dBm",
        "fps_display": "31 FPS",
        "console": "[PoseFusion] frame 1 OK - mode=dual, csi.bufLen=1, embPts=1"
      },
      "reproduced": "twice in two independent browser profiles",
      "note": "rv-energy stays 0.00; that readout comes from poseDecoder.attentionStats (RuVector WASM attention pipeline) and is unrelated to the CSI path"
    },
    "reproducer_commands": {
      "count_amplitude_suppression": "connect a stdlib WebSocket client to ws://127.0.0.1:8765/ws/sensing and per sensing_update compute [len(n['amplitude'] or []) for n in m['nodes']]; a message is 'suppressed' when every length is 0",
      "ab_soft_guard": "restart the server with and without WDP_SOFT_GUARD_US=55000 and compare the suppressed fraction over the same window length",
      "decode_wire": "stop the server, bind a UDP socket to 0.0.0.0:5005, and decode bytes 0..19 of every datagram (magic u32 LE, byte 4 node_id, byte 5 n_antennas, bytes 6..8 n_subcarriers u16 LE, bytes 8..12 freq_mhz, byte 16 rssi, byte 17 noise floor)"
    },
    "operator_commands_ubuntu": {
      "stop": "pkill -f sensing-server",
      "start": "cd ~/RuView/RuView/v2 && OPENBLAS_SYSTEM=1 WDP_SOFT_GUARD_US=55000 nohup ./target/debug/sensing-server --source esp32 --http-port 8080 --udp-port 5005 --udp-bind 0.0.0.0 --udp-allow 172.22.96.0/20 --bind-addr 0.0.0.0 --ui-path ../ui > rooms/roomB/server.log 2>&1 &",
      "start_cargo": "cd ~/RuView/RuView/v2 && OPENBLAS_SYSTEM=1 WDP_SOFT_GUARD_US=55000 cargo run -p wifi-densepose-sensing-server -- --source esp32 --http-port 8080 --udp-port 5005 --udp-bind 0.0.0.0 --udp-allow 172.22.96.0/20 --bind-addr 0.0.0.0 --ui-path ../ui",
      "ui_url": "http://localhost:8080/ui/pose-fusion.html",
      "health": "curl -s http://localhost:8080/api/v1/status | python3 -m json.tool",
      "ports": {
        "http_ui": 8080,
        "websocket": 8765,
        "udp_csi": 5005
      }
    },
